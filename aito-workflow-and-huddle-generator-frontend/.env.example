# Copy this file to .env.local (or .env.development / .env.production) and fill in values.
# Real .env files are git-ignored. Never commit real values.
#
# The standalone in-app build does NOT need any of these. They are only needed
# if the app is reconnected to the backend API and Microsoft Entra (MSAL) sign-in.

# Backend API
# VITE_API_BASE_URL=https://your-api-host/api

# Microsoft Entra ID (MSAL)
# VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_ENTRA_API_SCOPE=api://your-api-client-id/access_as_user
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
